# Ignore Docker-related files, but keep docker-compose.yml
*.log
.env
Dockerfile.*
docker-compose.override.yml

# Keep docker-compose.yml for users to run your setup
!docker-compose.yml

# Ignore Docker volumes and container data
**/data/*
**/volumes/*
!data/keep_this_file  # Example: keep an important file in data/

# Python-specific
*.pyc
*.pyo
*.pyd
__pycache__/
*.pytest_cache/
*.env
.venv/
*.ipynb_checkpoints/

# Node.js/JavaScript-specific
node_modules/
npm-debug.log
yarn-error.log
dist/
build/

# General machine vision tools (if applicable)
*.model
*.ckpt
*.weights
*.h5
__results__/
*.tfrecord

# IDE-specific (if using any)
.vscode/
.idea/
*.swp
*.swo

# Logs and runtime files
*.log
*.out
*.pid
*.swp

# OS-specific
.DS_Store
Thumbs.db

# Images, videos, or raw data (optional)
**/raw_data/*
**/output/*
*.mp4
*.avi
*.png
*.jpg
*.jpeg

# Archive files
*.zip
*.tar.gz
*.rar

# Generated by build tools
coverage/
*.coverage
*.egg-info
*.cache
